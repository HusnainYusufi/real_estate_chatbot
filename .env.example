# ── Claude API ────────────────────────────────────────────────────────────
# Used by the AI engine. Optional locally if you've run `ant auth login`.
ANTHROPIC_API_KEY=

# ── Database (NestJS API) ─────────────────────────────────────────────────
# Matches the docker-compose Postgres (host port ${POSTGRES_PORT:-5434}).
DATABASE_URL=postgres://chatbot:chatbot@localhost:5434/chatbot
POSTGRES_PORT=5434
# Dev convenience: TypeORM auto-syncs the schema. Set to false in production
# and use migrations instead.
DB_SYNC=true

# ── Service wiring ────────────────────────────────────────────────────────
API_PORT=4000
AI_ENGINE_URL=http://localhost:8000
INTERNAL_API_URL=http://localhost:4000
# Shared secret between the API and the AI engine — change it.
INTERNAL_API_KEY=dev-internal-key-change-me

# ── Auth & encryption ─────────────────────────────────────────────────────
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d
# Encrypts stored provider API keys at rest (AES-256-GCM). Long random string.
ENCRYPTION_KEY=change-me-to-a-long-random-string

# ── AI providers (optional fallback keys) ─────────────────────────────────
# Preferred: add keys in the admin panel → Providers (encrypted in the DB).
# These env vars are only a fallback the AI engine uses when no stored key
# matches a bot's provider.
# ANTHROPIC_API_KEY is set above.
OPENAI_API_KEY=
GEMINI_API_KEY=
GOOGLE_API_KEY=

# ── WhatsApp via OpenWA (optional) ────────────────────────────────────────
# Self-hosted gateway from docker-compose (dashboard on this URL).
OPENWA_URL=http://localhost:2785
# Create an API key in the OpenWA dashboard and paste it here.
OPENWA_API_KEY=
# Secret this API registers with OpenWA; webhook deliveries are HMAC-signed
# with it. Change to a long random string.
OPENWA_WEBHOOK_SECRET=dev-openwa-webhook-secret-change-me
# URL where OpenWA can reach THIS API (webhooks). In docker: http://api:4000
PUBLIC_API_URL=http://localhost:4000

# ── Voice / phone calls (optional — `docker compose --profile voice up`) ──
# LiveKit powers the realtime media + SIP. Dev defaults match infra/livekit.yaml.
VOICE_AGENT_URL=http://localhost:8100
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=devsecret_change_me_32chars_min__
# Deepgram = streaming speech-to-text (+ a TTS voice). Get a key at deepgram.com.
DEEPGRAM_API_KEY=
# TTS engine for the bot's voice: "deepgram" or "openai".
VOICE_TTS_PROVIDER=deepgram
# Outbound SIP trunk id from scripts/provision_trunk.py (needs a carrier account).
SIP_OUTBOUND_TRUNK_ID=

# ── Admin panel ───────────────────────────────────────────────────────────
# Base URL of the API as seen from the admin-panel user's browser.
NEXT_PUBLIC_API_URL=http://localhost:4000

# ── Options ───────────────────────────────────────────────────────────────
# Allow custom webhook tools to call private/localhost hosts (local dev only).
ALLOW_PRIVATE_WEBHOOKS=0
# Allow http:// (non-TLS) webhook URLs when creating bots (local dev only).
ALLOW_INSECURE_WEBHOOKS=0
# Set to 1 to disable server-side refusal fallbacks (beta).
DISABLE_REFUSAL_FALLBACK=0
